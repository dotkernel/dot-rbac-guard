{
    "name": "dotkernel/dot-rbac-guard",
    "type": "library",
    "description": "Dotkernel RBAC guards component",
    "license": "MIT",
    "homepage": "https://github.com/dotkernel/dot-rbac-guard",
    "keywords": [
        "authentication",
        "authorization",
        "laminas",
        "mezzio",
        "rbac-guard",
        "rbac"
    ],
    "authors": [
        {
            "name": "Dotkernel Team",
            "email": "team@dotkernel.com"
        }
    ],
    "require": {
        "php": "~8.1.0 || ~8.2.0 || ~8.3.0 || ~8.4.0",
        "dotkernel/dot-authentication": "^2.3.4",
        "dotkernel/dot-controller": "^4.0",
        "dotkernel/dot-rbac": "^4.0",
        "laminas/laminas-diactoros": "^3.3.0",
        "laminas/laminas-servicemanager": "^4.0",
        "laminas/laminas-stdlib": "^3.19",
        "mezzio/mezzio-router": "^3.17",
        "mezzio/mezzio-template": "^2.10.0",
        "psr/http-message": "^1.0 || ^2.0",
        "psr/http-server-middleware": "^1.0"
    },
    "require-dev": {
        "laminas/laminas-coding-standard": "^3.0",
        "phpunit/phpunit": "^10.5.9",
        "vimeo/psalm": "^5.20"
    },
    "autoload": {
        "psr-4": {
            "Dot\\Rbac\\Guard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DotTest\\Rbac\\Guard\\": "test/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "laminas/laminas-dependency-plugin": false
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@test",
            "@static-analysis"
        ],
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "test": "phpunit --colors=always",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml",
        "static-analysis": "psalm --shepherd --stats"
    }
}
